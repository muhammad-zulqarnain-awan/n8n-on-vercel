# --- Required (set in Vercel > Project > Settings > Environment Variables) ---

# Generate once with: openssl rand -hex 32   -- NEVER change it afterwards (it encrypts your credentials)
N8N_ENCRYPTION_KEY=

# Your custom domain, used for editor, webhook and form URLs
N8N_PUBLIC_URL=https://n8n.example.com

# The Neon integration injects DATABASE_URL / DATABASE_URL_UNPOOLED automatically.

# --- Optional ---
# Shut n8n down after this many idle seconds so Neon can sleep (Neon free suspends after 5 min)
N8N_IDLE_SHUTDOWN_SECONDS=240

# Enables GET /__status with header x-status-token
STATUS_TOKEN=
EXECUTIONS_DATA_MAX_AGE=72
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000
GENERIC_TIMEZONE=UTC
